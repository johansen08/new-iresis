# ============================================================
#  Editor & dependency
# ============================================================
.vscode

# Izin lokal Claude Code — entrinya bisa memuat cuplikan perintah berisi token
.claude/settings.local.json
/vendor/

# ============================================================
#  KREDENSIAL — jangan pernah di-commit
# ============================================================
# Sniffer output (berisi token & cookie login)
**/sniff_out/

# Kredensial Jubelio untuk script otomasi
scripts/.env
scripts/jubelio_credentials.py

# Kredensial aplikasi (DB, Pusher)
# Template yang ikut di-commit: application/config/secrets.php.example
application/config/secrets.php
scripts/secrets_local.py

# Bytecode Python: jubelio_credentials.pyc tetap memuat kredensial
# walau file .py-nya sudah di-ignore
__pycache__/
*.py[cod]

# ============================================================
#  Output runtime & file yang dihasilkan aplikasi
# ============================================================
application/logs/
application/cache/
application/brain/
logs/
tmp/
debug_output.txt
*.log

# Hasil upload user saat aplikasi berjalan
assets/uploads/

# Foto profil user (hasil upload)
assets/img/users/*
!assets/img/users/avatar.jpg

# ============================================================
#  Binary pihak ketiga & dependency
# ============================================================
node_modules/

# ============================================================
#  Scratch / dev tooling — script sekali pakai, bukan kode aplikasi
# ============================================================
dev_tools/

scratch/

# Script debug/investigasi sekali pakai di root
/test_*.php
/check_*.php
/describe_*.php
/dump_db*.php
/debug_*.php
/db_test*.php
/inspect_menu*.php
/list_*.php
/find_*menu*.php
/find_parent_name.php
/scratch_*.php
/tmp_*.php
/*_menu_placement.php
/add_menu_script.php
/direct_menu_add.php
/grant_menu_access.php
/run_add_menu.php
/do_cleanup_2025.php
/dry_run_cancel.php
/dev_models.txt
/dev_uri*.txt
/prod_models.txt
/prod_uri*.txt

# Cache foto produk hasil Cron::sinkron_foto_sku (±500 MB, bisa diunduh ulang)
assets/foto_sku/*
!assets/foto_sku/.gitkeep
